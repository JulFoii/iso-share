<!DOCTYPE html>
<html lang="de">
<head>
  <%- include('partials/head', { title: 'ISO-Images', description: 'Verfügbare ISO-Images herunterladen — ISO Share.' }) %>
</head>
<body data-heartbeat="public">
<a class="skip-link" href="#main">Zum Inhalt springen</a>
<%- include('partials/navbar', { page: 'index', loggedIn }) %>

<main class="main" id="main">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">ISO-Images</h1>
      <p class="page-header__meta">
        <span><span data-visible-count><%= files.length %></span> <%= files.length === 1 ? 'Datei' : 'Dateien' %></span>
        <span data-total-size><%= formatSize(files.reduce((sum, file) => sum + file.size, 0)) %></span>
        <% if (files.length > 0) { %>
          <a class="page-header__link" href="/checksums" download>SHA256SUMS</a>
        <% } %>
      </p>
    </header>

    <div class="stack">
      <% if (files.length > 0) { %>
        <!-- Ohne JavaScript sucht das Formular serverseitig, filetable.js
             filtert sonst direkt im Browser. -->
        <form class="search<%= typeof searchQuery !== 'undefined' && searchQuery ? ' search--active' : '' %>" action="/search" method="GET" role="search">
          <svg class="search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5"/>
          </svg>
          <label class="visually-hidden" for="search">Dateien filtern</label>
          <input
            class="input"
            type="search"
            id="search"
            name="q"
            data-filter
            placeholder="Filtern nach Name, Tag, Label… (/)"
            autocomplete="off"
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
          <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <a class="search__reset" href="/" aria-label="Suche zurücksetzen" title="Suche zurücksetzen">×</a>
          <% } %>
        </form>
        <div data-tag-filter>
          <%- include('partials/tag-filter', { allTags: typeof allTags !== 'undefined' ? allTags : [], searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '', searchBase: '/search' }) %>
        </div>
      <% } %>

      <div class="card card--flush reveal">
        <% if (files.length === 0) { %>
          <div class="empty">
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <p class="empty__title">Noch keine Images vorhanden</p>
            <p class="empty__text">Sobald ein Administrator ein ISO-Image hochlädt, erscheint es hier zum Download.</p>
          </div>
        <% } else { %>
          <div class="card__toolbar bulk-bar" data-bulk-bar hidden>
            <span class="bulk-bar__count"><span data-bulk-count>0</span> ausgewählt</span>
            <div class="bulk-bar__actions">
              <button type="button" class="btn btn--secondary btn--sm" data-bulk-zip>Als ZIP herunterladen</button>
              <button type="button" class="btn btn--ghost btn--sm" data-bulk-clear>Auswahl aufheben</button>
            </div>
          </div>

          <div class="table-scroll">
            <table class="table" data-filetable>
              <thead>
                <tr>
                  <th scope="col" class="table__select">
                    <input type="checkbox" data-select-all aria-label="Alle auswählen">
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="text">
                      Name
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Größe
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Hochgeladen
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col"><span class="visually-hidden">Aktionen</span></th>
                </tr>
              </thead>
              <tbody data-file-rows>
                <%- include('partials/file-rows', { files, admin: false }) %>
              </tbody>
            </table>
          </div>

          <div class="empty" data-filter-empty hidden>
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
              </svg>
            </div>
            <p class="empty__title">Keine Treffer</p>
            <p class="empty__text">Kein Dateiname passt zum Filter. Versuche einen kürzeren Suchbegriff.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script src="/js/theme.js" defer></script>
<script src="/js/idle-timer.js" defer></script>
<script src="/js/filetable.js" defer></script>
<script src="/js/row-details.js" defer></script>
<script src="/js/copy.js" defer></script>
<script src="/js/toast.js" defer></script>
<script src="/js/bulk-actions.js" defer></script>
<script src="/js/heartbeat.js" defer></script>
</body>
</html>
