<!DOCTYPE html>
<html lang="de">
<head>
  <%- include('partials/head', { title: 'ISO-Images', description: 'Verfügbare ISO-Images herunterladen — ISO Share.' }) %>
</head>
<body>
<a class="skip-link" href="#main">Zum Inhalt springen</a>
<%- include('partials/navbar', { page: 'index', loggedIn }) %>

<main class="main" id="main">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">ISO-Images</h1>
      <p class="page-header__meta">
        <span><span data-visible-count><%= files.length %></span> <%= files.length === 1 ? 'Datei' : 'Dateien' %></span>
        <span><%= formatSize(files.reduce((sum, file) => sum + file.size, 0)) %></span>
      </p>
    </header>

    <div class="stack">
      <% if (files.length > 0) { %>
        <!-- Ohne JavaScript sucht das Formular serverseitig, filetable.js
             filtert sonst direkt im Browser. -->
        <form class="search" action="/search" method="GET" role="search">
          <svg class="search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5"/>
          </svg>
          <label class="visually-hidden" for="search">Dateien filtern</label>
          <input
            class="input"
            type="search"
            id="search"
            name="q"
            data-filter
            placeholder="Filtern… (/)"
            autocomplete="off"
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        </form>
      <% } %>

      <div class="card card--flush reveal">
        <% if (files.length === 0) { %>
          <div class="empty">
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <p class="empty__title">Noch keine Images vorhanden</p>
            <p class="empty__text">Sobald ein Administrator ein ISO-Image hochlädt, erscheint es hier zum Download.</p>
          </div>
        <% } else { %>
          <div class="table-scroll">
            <table class="table" data-filetable>
              <thead>
                <tr>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="text">
                      Name
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Größe
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Hochgeladen
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col"><span class="visually-hidden">Aktionen</span></th>
                </tr>
              </thead>
              <tbody>
                <% files.forEach(file => { %>
                  <tr data-search="<%= file.name %>">
                    <td class="table__name" data-label="Name"><%= file.name %></td>
                    <td class="table__num" data-label="Größe" data-value="<%= file.size %>"><%= formatSize(file.size) %></td>
                    <td class="table__num" data-label="Hochgeladen" data-value="<%= file.mtime %>">
                      <time datetime="<%= new Date(file.mtime).toISOString() %>"><%= formatDate(file.mtime) %></time>
                    </td>
                    <td class="table__actions" data-label="">
                      <a class="btn btn--secondary btn--sm" href="/download/<%= encodeURIComponent(file.name) %>" download>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>
                        </svg>
                        Download
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="empty" data-filter-empty hidden>
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
              </svg>
            </div>
            <p class="empty__title">Keine Treffer</p>
            <p class="empty__text">Kein Dateiname passt zum Filter. Versuche einen kürzeren Suchbegriff.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script src="/js/theme.js" defer></script>
<script src="/js/filetable.js" defer></script>
</body>
</html>
