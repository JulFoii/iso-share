<%# Felder des Backup-Zeitplans — eigenes Partial, weil heartbeat.js sie
    ueber GET /admin/partials/listing nachgeliefert bekommt (Live-Bereich
    "backup-settings", siehe live-regions.js). %>
        <div class="field">
          <label class="label" for="backupInterval">Intervall (Minuten)</label>
          <input
            class="input"
            type="number"
            id="backupInterval"
            name="intervalMinutes"
            min="5"
            max="1440"
            value="<%= backupSettings.intervalMinutes %>"
            required>
        </div>
        <div class="field">
          <label class="label" for="backupRetention">Aufbewahrte Sicherungen</label>
          <input
            class="input"
            type="number"
            id="backupRetention"
            name="retentionCount"
            min="1"
            max="500"
            value="<%= backupSettings.retentionCount %>"
            required>
        </div>
        <label class="row">
          <input type="checkbox" id="backupEnabled" name="enabled" <%= backupSettings.enabled ? 'checked' : '' %>>
          Automatische Sicherung aktiv
        </label>
