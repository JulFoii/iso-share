<!DOCTYPE html>
<html lang="de">
<head>
  <%- include('partials/head', { title: 'Verwaltung' }) %>
</head>
<body>
<a class="skip-link" href="#main">Zum Inhalt springen</a>
<%- include('partials/navbar', { page: 'admin', loggedIn: true }) %>

<main class="main" id="main">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">Verwaltung</h1>
      <p class="page-header__meta">
        <span><span data-visible-count><%= files.length %></span> <%= files.length === 1 ? 'Datei' : 'Dateien' %></span>
        <span><%= formatSize(files.reduce((sum, file) => sum + file.size, 0)) %></span>
      </p>
    </header>

    <div class="stack">
      <!-- Upload -->
      <section class="card reveal" aria-labelledby="upload-heading">
        <div class="card__header">
          <h2 class="card__title" id="upload-heading">Image hochladen</h2>
          <span class="badge spacer">.iso</span>
        </div>
        <div class="card__body">
          <form id="uploadForm" class="stack" enctype="multipart/form-data" method="POST" action="/upload">
            <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-describedby="dropzone-hint">
              <svg class="dropzone__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 16V4M7 9l5-5 5 5"/>
                <path d="M20 15v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3"/>
              </svg>
              <p class="dropzone__title">ISO-Datei hierher ziehen</p>
              <p class="dropzone__hint" id="dropzone-hint">oder klicken, um eine Datei auszuwählen</p>
            </div>

            <label class="visually-hidden" for="fileInput">ISO-Datei</label>
            <input type="file" id="fileInput" name="file" accept=".iso,application/x-iso9660-image" hidden required>

            <div class="file-preview" id="filePreview" hidden>
              <svg class="file-preview__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <span class="file-preview__name" id="filePreviewName"></span>
              <span class="badge file-preview__size" id="filePreviewSize"></span>
            </div>

            <div class="progress" id="uploadProgress" hidden>
              <div class="progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Upload-Fortschritt">
                <div class="progress__bar" id="uploadProgressBar"></div>
              </div>
              <p class="progress__label">
                <span id="uploadTransfer"></span>
                <span id="uploadPercent">0 %</span>
              </p>
            </div>

            <div class="row">
              <button type="submit" class="btn btn--primary" id="uploadSubmit" disabled>Hochladen</button>
              <span class="hint">Bestehende Dateien mit gleichem Namen werden überschrieben.</span>
            </div>
          </form>
        </div>
      </section>

      <!-- Dateien -->
      <section class="card card--flush reveal" aria-labelledby="files-heading">
        <div class="card__header">
          <h2 class="card__title" id="files-heading">Hochgeladene Images</h2>
        </div>

        <% if (files.length === 0) { %>
          <div class="empty">
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <p class="empty__title">Keine Dateien</p>
            <p class="empty__text">Lade oben ein ISO-Image hoch — es erscheint dann sofort in der öffentlichen Liste.</p>
          </div>
        <% } else { %>
          <div class="card__toolbar">
            <form class="search" action="/admin-search" method="GET" role="search">
              <svg class="search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
              </svg>
              <label class="visually-hidden" for="search">Dateien filtern</label>
              <input
                class="input"
                type="search"
                id="search"
                name="q"
                data-filter
                placeholder="Filtern… (/)"
                autocomplete="off"
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            </form>
          </div>

          <div class="table-scroll">
            <table class="table" data-filetable>
              <thead>
                <tr>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="text">
                      Name
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Größe
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Hochgeladen
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col"><span class="visually-hidden">Aktionen</span></th>
                </tr>
              </thead>
              <tbody>
                <% files.forEach(file => { %>
                  <tr data-search="<%= file.name %>">
                    <td class="table__name" data-label="Name"><%= file.name %></td>
                    <td class="table__num" data-label="Größe" data-value="<%= file.size %>"><%= formatSize(file.size) %></td>
                    <td class="table__num" data-label="Hochgeladen" data-value="<%= file.mtime %>">
                      <time datetime="<%= new Date(file.mtime).toISOString() %>"><%= formatDate(file.mtime) %></time>
                    </td>
                    <td class="table__actions" data-label="">
                      <span class="table__row-actions">
                        <a class="btn btn--ghost btn--sm" href="/download/<%= encodeURIComponent(file.name) %>" download>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>
                          </svg>
                          <span class="visually-hidden">Herunterladen: <%= file.name %></span>
                        </a>
                        <button type="button" class="btn btn--danger-ghost btn--sm" data-delete="<%= file.name %>">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 7h16M10 11v6M14 11v6"/>
                            <path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                          </svg>
                          <span class="visually-hidden">Löschen: <%= file.name %></span>
                        </button>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="empty" data-filter-empty hidden>
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
              </svg>
            </div>
            <p class="empty__title">Keine Treffer</p>
            <p class="empty__text">Kein Dateiname passt zum Filter.</p>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<dialog class="dialog" id="deleteDialog">
  <form method="POST" action="/delete">
    <div class="dialog__body">
      <h2 class="dialog__title">Datei löschen?</h2>
      <p class="dialog__text">
        <strong class="mono" id="deleteDialogFilename"></strong>
        wird endgültig vom Server entfernt. Das lässt sich nicht zurücknehmen.
      </p>
      <input type="hidden" name="filename" id="deleteDialogInput">
    </div>
    <div class="dialog__footer">
      <button type="submit" class="btn btn--secondary" formmethod="dialog" formnovalidate>Abbrechen</button>
      <button type="submit" class="btn btn--danger">Löschen</button>
    </div>
  </form>
</dialog>

<script src="/js/theme.js" defer></script>
<script src="/js/toast.js" defer></script>
<script src="/js/filetable.js" defer></script>
<script src="/js/delete-dialog.js" defer></script>
<script src="/js/upload.js" defer></script>
</body>
</html>
