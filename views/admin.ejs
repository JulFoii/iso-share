<!DOCTYPE html>
<html lang="de">
<head>
  <%- include('partials/head', { title: 'Verwaltung' }) %>
</head>
<body>
<a class="skip-link" href="#main">Zum Inhalt springen</a>
<%- include('partials/navbar', { page: 'admin', loggedIn: true }) %>

<main class="main" id="main">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">Verwaltung</h1>
      <p class="page-header__meta">
        <span><span data-visible-count><%= files.length %></span> <%= files.length === 1 ? 'Datei' : 'Dateien' %></span>
        <span><%= formatSize(files.reduce((sum, file) => sum + file.size, 0)) %></span>
        <% if (files.length > 0) { %>
          <a class="page-header__link" href="/checksums" download>SHA256SUMS</a>
        <% } %>
      </p>
    </header>

    <nav class="tabs" aria-label="Verwaltungsbereiche" data-tabs>
      <a class="tab" href="#tab-files" data-tab-link="files" aria-current="page">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        Dateien
      </a>
      <a class="tab" href="#tab-security" data-tab-link="security">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Sicherheit
      </a>
      <a class="tab" href="#tab-account" data-tab-link="account">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c0-4 4-7 8-7s8 3 8 7"/>
        </svg>
        Konto
      </a>
    </nav>

    <div class="stack" id="tab-files" data-tab-panel="files">
      <!-- Upload -->
      <section class="card reveal" aria-labelledby="upload-heading">
        <div class="card__header">
          <h2 class="card__title" id="upload-heading">Image hochladen</h2>
          <span class="badge spacer">.iso</span>
          <span class="badge">max <%= formatSize(maxFileSizeMb * 1024 * 1024) %></span>
        </div>
        <div class="card__body">
          <form id="uploadForm" class="stack" enctype="multipart/form-data" method="POST" action="/upload">
            <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-describedby="dropzone-hint">
              <svg class="dropzone__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 16V4M7 9l5-5 5 5"/>
                <path d="M20 15v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3"/>
              </svg>
              <p class="dropzone__title">ISO-Datei hierher ziehen</p>
              <p class="dropzone__hint" id="dropzone-hint">oder klicken, um eine Datei auszuwählen</p>
            </div>

            <label class="visually-hidden" for="fileInput">ISO-Datei</label>
            <input type="file" id="fileInput" name="file" accept=".iso,application/x-iso9660-image" hidden required>

            <div class="file-preview" id="filePreview" hidden>
              <svg class="file-preview__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <span class="file-preview__name" id="filePreviewName"></span>
              <span class="badge file-preview__size" id="filePreviewSize"></span>
            </div>

            <!-- Wird von upload.js gefuellt, wenn der Server zu dieser Datei
                 noch eine offene Upload-Sitzung hat. -->
            <div class="alert alert--info" id="uploadResume" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4M12 8h.01"/>
              </svg>
              <span id="uploadResumeText"></span>
            </div>

            <div class="progress" id="uploadProgress" hidden>
              <div class="progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Upload-Fortschritt">
                <div class="progress__bar" id="uploadProgressBar"></div>
              </div>
              <p class="progress__label">
                <span id="uploadTransfer"></span>
                <span id="uploadPercent">0 %</span>
              </p>
            </div>

            <div class="row">
              <button type="submit" class="btn btn--primary" id="uploadSubmit" disabled>Hochladen</button>
              <button type="button" class="btn btn--secondary" id="uploadPause" hidden>Pause</button>
              <button type="button" class="btn btn--danger-ghost" id="uploadCancel" hidden>Abbrechen</button>
              <span class="hint">
                Große Images werden in Blöcken übertragen und lassen sich nach
                einem Abbruch fortsetzen. Bestehende Dateien mit gleichem Namen
                werden überschrieben.
              </span>
            </div>
          </form>
        </div>
      </section>

      <!-- Dateien -->
      <section class="card card--flush reveal" aria-labelledby="files-heading">
        <div class="card__header">
          <h2 class="card__title" id="files-heading">Hochgeladene Images</h2>
        </div>

        <% if (files.length === 0) { %>
          <div class="empty">
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <p class="empty__title">Keine Dateien</p>
            <p class="empty__text">Lade oben ein ISO-Image hoch — es erscheint dann sofort in der öffentlichen Liste.</p>
          </div>
        <% } else { %>
          <div class="card__toolbar">
            <form class="search" action="/admin-search" method="GET" role="search">
              <svg class="search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
              </svg>
              <label class="visually-hidden" for="search">Dateien filtern</label>
              <input
                class="input"
                type="search"
                id="search"
                name="q"
                data-filter
                placeholder="Filtern… (/)"
                autocomplete="off"
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            </form>
          </div>

          <div class="card__toolbar bulk-bar" data-bulk-bar hidden>
            <span class="bulk-bar__count"><span data-bulk-count>0</span> ausgewählt</span>
            <div class="bulk-bar__actions">
              <button type="button" class="btn btn--secondary btn--sm" data-bulk-zip>Als ZIP herunterladen</button>
              <button type="button" class="btn btn--danger-ghost btn--sm" data-bulk-delete>Löschen</button>
              <button type="button" class="btn btn--ghost btn--sm" data-bulk-clear>Auswahl aufheben</button>
            </div>
          </div>

          <div class="table-scroll">
            <table class="table" data-filetable>
              <thead>
                <tr>
                  <th scope="col" class="table__select">
                    <input type="checkbox" data-select-all aria-label="Alle auswählen">
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="text">
                      Name
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Größe
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col">
                    <button type="button" class="table__sort" data-sort-type="number">
                      Hochgeladen
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </th>
                  <th scope="col"><span class="visually-hidden">Aktionen</span></th>
                </tr>
              </thead>
              <tbody>
                <% files.forEach((file, index) => { %>
                  <%- include('partials/file-row', { file, index, admin: true }) %>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="empty" data-filter-empty hidden>
            <div class="empty__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
              </svg>
            </div>
            <p class="empty__title">Keine Treffer</p>
            <p class="empty__text">Kein Dateiname passt zum Filter.</p>
          </div>
        <% } %>
      </section>
    </div>

    <div class="stack" id="tab-security" data-tab-panel="security">
      <!-- Passkeys -->
      <section class="card reveal" aria-labelledby="passkeys-heading">
        <div class="card__header">
          <h2 class="card__title" id="passkeys-heading">Passkeys</h2>
        </div>
        <div class="card__body">
          <ul class="stack" id="passkeyList">
            <% passkeys.forEach(passkey => { %>
              <%- include('partials/passkey-row', { passkey }) %>
            <% }); %>
            <% if (passkeys.length === 0) { %>
              <li class="empty" data-passkey-empty>
                <p class="empty__title">Keine Passkeys</p>
                <p class="empty__text">Füge einen Passkey hinzu, um dich künftig ohne Passwort anzumelden.</p>
              </li>
            <% } %>
          </ul>
          <div class="row mt-4">
            <button type="button" class="btn btn--secondary" id="passkeyAddButton" hidden>Passkey hinzufügen</button>
            <span class="hint" id="passkeyUnsupportedHint">Dieser Browser unterstützt keine Passkeys.</span>
          </div>
        </div>
      </section>

      <!-- Zwei-Faktor (TOTP) -->
      <section class="card reveal" aria-labelledby="totp-heading">
        <div class="card__header">
          <h2 class="card__title" id="totp-heading">Zwei-Faktor-Authentifizierung</h2>
          <span class="badge <%= totpEnabled ? 'badge--ok' : '' %>" id="totpStatusBadge"><%= totpEnabled ? 'Aktiv' : 'Inaktiv' %></span>
        </div>
        <div class="card__body">
          <p class="hint mb-4">
            Zusätzlicher Code aus einer Authenticator-App beim Passwort-Login.
            Gilt nicht für die Anmeldung per Passkey — die zählt schon als
            gleichwertig starker Faktor.
          </p>
          <div class="row">
            <button type="button" class="btn btn--secondary" id="totpSetupButton" <%= totpEnabled ? 'hidden' : '' %>>TOTP einrichten</button>
            <button type="button" class="btn btn--danger-ghost" id="totpDisableButton" <%= totpEnabled ? '' : 'hidden' %>>Deaktivieren</button>
          </div>
        </div>
      </section>

      <!-- Audit-Log -->
      <section class="card reveal" aria-labelledby="audit-heading">
        <div class="card__header">
          <h2 class="card__title" id="audit-heading">Audit-Log</h2>
          <a class="btn btn--ghost btn--sm" href="/admin-audit-log">Alle ansehen</a>
        </div>
        <div class="card__body">
          <% if (auditEntries.length === 0) { %>
            <p class="hint">Noch keine Einträge.</p>
          <% } else { %>
            <ul class="stack">
              <% auditEntries.forEach(entry => { %>
                <li class="row row--between">
                  <span><span class="badge badge--mono"><%= entry.event %></span> <span class="hint"><%= entry.ip || '' %></span></span>
                  <time class="hint" datetime="<%= new Date(entry.ts).toISOString() %>"><%= formatDate(entry.ts) %> <%= new Date(entry.ts).toLocaleTimeString('de-DE') %></time>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </section>
    </div>

    <div class="stack" id="tab-account" data-tab-panel="account">
      <!-- Admin-Benutzername -->
      <section class="card reveal" aria-labelledby="username-heading">
        <div class="card__header">
          <h2 class="card__title" id="username-heading">Admin-Benutzername</h2>
        </div>
        <div class="card__body">
          <% if (usernameError) { %>
            <div class="alert alert--danger mb-4" role="alert">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4M12 16h.01"/>
              </svg>
              <span><%= usernameError %></span>
            </div>
          <% } %>

          <form class="stack" id="usernameForm" method="POST" action="/admin-username">
            <div class="field">
              <label class="label" for="usernameInput">Benutzername</label>
              <input
                class="input"
                type="text"
                id="usernameInput"
                name="username"
                value="<%= currentUsername %>"
                maxlength="64"
                required>
            </div>

            <div class="row">
              <button type="submit" class="btn btn--secondary">Benutzername ändern</button>
              <span class="hint">Gilt sofort für neue Anmeldungen; bestehende Sitzungen bleiben angemeldet.</span>
            </div>
          </form>
        </div>
      </section>

      <!-- Admin-Passwort -->
      <section class="card reveal" aria-labelledby="password-heading">
        <div class="card__header">
          <h2 class="card__title" id="password-heading">Admin-Passwort</h2>
        </div>
        <div class="card__body">
          <% if (passwordError) { %>
            <div class="alert alert--danger mb-4" role="alert">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4M12 16h.01"/>
              </svg>
              <span><%= passwordError %></span>
            </div>
          <% } %>

          <form class="stack" id="passwordForm" method="POST" action="/admin-password">
            <div class="field">
              <label class="label" for="newPassword">Neues Passwort</label>
              <div class="password">
                <input
                  class="input"
                  type="password"
                  id="newPassword"
                  name="password"
                  autocomplete="new-password"
                  minlength="8"
                  required>
                <button
                  type="button"
                  class="password__toggle"
                  data-password-toggle="newPassword"
                  aria-label="Passwort anzeigen">
                  <svg data-password-icon="show" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  <svg data-password-icon="hide" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                    <path d="M4 4l16 16"/>
                    <path d="M9.9 5.2A9.6 9.6 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-2.4 3.3M6.5 7.3A17 17 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 3.9-.8"/>
                    <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
                  </svg>
                </button>
              </div>
            </div>

            <div class="field">
              <label class="label" for="confirmPassword">Passwort bestätigen</label>
              <div class="password">
                <input
                  class="input"
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  autocomplete="new-password"
                  minlength="8"
                  required>
                <button
                  type="button"
                  class="password__toggle"
                  data-password-toggle="confirmPassword"
                  aria-label="Passwort anzeigen">
                  <svg data-password-icon="show" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  <svg data-password-icon="hide" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                    <path d="M4 4l16 16"/>
                    <path d="M9.9 5.2A9.6 9.6 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-2.4 3.3M6.5 7.3A17 17 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 3.9-.8"/>
                    <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
                  </svg>
                </button>
              </div>
            </div>

            <div class="row">
              <button type="submit" class="btn btn--secondary">Passwort ändern</button>
              <span class="hint">Gilt sofort für neue Anmeldungen; bestehende Sitzungen bleiben angemeldet.</span>
            </div>
          </form>
        </div>
      </section>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<dialog class="dialog" id="usernameResultDialog">
  <form method="dialog">
    <div class="dialog__body">
      <h2 class="dialog__title" data-result-title>Benutzername geändert</h2>
      <p class="dialog__text" data-result-text></p>
    </div>
    <div class="dialog__footer">
      <button type="submit" class="btn btn--primary">OK</button>
    </div>
  </form>
</dialog>

<dialog class="dialog" id="passwordResultDialog">
  <form method="dialog">
    <div class="dialog__body">
      <h2 class="dialog__title" data-result-title>Passwort geändert</h2>
      <p class="dialog__text" data-result-text></p>
    </div>
    <div class="dialog__footer">
      <button type="submit" class="btn btn--primary">OK</button>
    </div>
  </form>
</dialog>

<dialog class="dialog" id="totpSetupDialog">
  <form method="dialog">
    <div class="dialog__body">
      <h2 class="dialog__title">TOTP einrichten</h2>
      <p class="dialog__text">
        In einer Authenticator-App (z. B. Aegis, Google Authenticator) als
        Setup-Schlüssel eintragen — es gibt bewusst keinen QR-Code, jede App
        akzeptiert die manuelle Eingabe.
      </p>
      <div class="field">
        <label class="label">Setup-Schlüssel</label>
        <div class="row">
          <code class="mono" id="totpSecretDisplay"></code>
          <button type="button" class="btn btn--ghost btn--sm" id="totpSecretCopy" data-copy-label="Schlüssel kopiert">Kopieren</button>
        </div>
      </div>
      <div class="field">
        <label class="label" for="totpToken">Code aus der App</label>
        <input class="input" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" id="totpToken" autocomplete="one-time-code">
      </div>
      <p class="hint" id="totpSetupError"></p>
    </div>
    <div class="dialog__footer">
      <button type="submit" class="btn btn--secondary" formnovalidate>Abbrechen</button>
      <button type="button" class="btn btn--primary" id="totpSetupConfirm">Bestätigen</button>
    </div>
  </form>
</dialog>

<dialog class="dialog" id="totpRecoveryDialog">
  <form method="dialog">
    <div class="dialog__body">
      <h2 class="dialog__title">Wiederherstellungscodes</h2>
      <p class="dialog__text">
        Jeder Code funktioniert einmal, falls das Gerät mit der
        Authenticator-App verloren geht. Jetzt sichern — sie werden nicht
        erneut angezeigt.
      </p>
      <ul class="stack mono" id="totpRecoveryList"></ul>
    </div>
    <div class="dialog__footer">
      <button type="submit" class="btn btn--primary">Codes gesichert</button>
    </div>
  </form>
</dialog>

<dialog class="dialog" id="bulkDeleteDialog">
  <form method="dialog">
    <div class="dialog__body">
      <h2 class="dialog__title">Ausgewählte Dateien löschen?</h2>
      <p class="dialog__text">
        <strong class="mono" data-bulk-delete-list></strong>
        werden endgültig vom Server entfernt. Das lässt sich nicht zurücknehmen.
      </p>
    </div>
    <div class="dialog__footer">
      <button type="submit" class="btn btn--secondary" formnovalidate>Abbrechen</button>
      <button type="button" class="btn btn--danger" data-bulk-delete-confirm>Löschen</button>
    </div>
  </form>
</dialog>

<dialog class="dialog" id="deleteDialog">
  <form method="POST" action="/delete">
    <div class="dialog__body">
      <h2 class="dialog__title">Datei löschen?</h2>
      <p class="dialog__text">
        <strong class="mono" id="deleteDialogFilename"></strong>
        wird endgültig vom Server entfernt. Das lässt sich nicht zurücknehmen.
      </p>
      <input type="hidden" name="filename" id="deleteDialogInput">
    </div>
    <div class="dialog__footer">
      <button type="submit" class="btn btn--secondary" formmethod="dialog" formnovalidate>Abbrechen</button>
      <button type="submit" class="btn btn--danger">Löschen</button>
    </div>
  </form>
</dialog>

<script src="/js/theme.js" defer></script>
<script src="/js/toast.js" defer></script>
<script src="/js/admin-tabs.js" defer></script>
<script src="/js/filetable.js" defer></script>
<script src="/js/delete-dialog.js" defer></script>
<script src="/js/bulk-actions.js" defer></script>
<script src="/js/row-details.js" defer></script>
<script src="/js/copy.js" defer></script>
<script src="/js/upload.js" defer></script>
<script src="/js/webauthn.js" defer></script>
<script src="/js/totp.js" defer></script>
<script src="/js/password-toggle.js" defer></script>
<script src="/js/account-forms.js" defer></script>
</body>
</html>
