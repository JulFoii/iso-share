<!DOCTYPE html>
<html lang="de">
<head>
  <%- include('partials/head', { title: 'Zwei-Faktor-Code' }) %>
  <meta name="robots" content="noindex">
</head>
<body>
<%- include('partials/navbar', { page: 'login', loggedIn: false }) %>

<main class="auth" id="main">
  <div class="auth__card">
    <div class="auth__head">
      <span class="auth__logo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <rect x="4" y="10" width="16" height="11" rx="2"/>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
      </span>
      <h1 class="auth__title">Zwei-Faktor-Code</h1>
      <p class="auth__subtitle">Gib den Code aus deiner Authenticator-App ein, oder ersatzweise einen Wiederherstellungscode.</p>
    </div>

    <div class="card">
      <div class="card__body">
        <% if (error) { %>
          <div class="alert alert--danger mb-4" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 8v4M12 16h.01"/>
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <form class="stack" action="/login/totp" method="POST">
          <div class="field">
            <label class="label" for="token">Code</label>
            <input
              class="input"
              type="text"
              id="token"
              name="token"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="19"
              required
              autofocus>
          </div>

          <button type="submit" class="btn btn--primary btn--block">Bestätigen</button>
        </form>
      </div>
    </div>

    <p class="hint mt-4 text-center">
      <a href="/login">Zurück zur Anmeldung</a>
    </p>
  </div>
</main>

<%- include('partials/footer') %>

<script src="/js/theme.js" defer></script>
<script src="/js/toast.js" defer></script>
</body>
</html>
