# Vorlage fuer die Produktiv-.env neben docker-compose.yml.
# Kopieren nach .env, ausfuellen, Rechte einschraenken:  chmod 600 .env
# Details zu jeder Variable: OPERATIONS.md und CLAUDE.md.

# --- Oeffentliche Adresse und TLS -------------------------------------------
# Domain fuer den mitgelieferten Caddy (docker compose --profile tls up -d)
DOMAIN=iso.example.com
# Basis fuer alle Links in Mails — muss https:// sein
PUBLIC_URL=https://iso.example.com
# Anzahl Proxy-Hops vor der App (1 = Caddy/nginx davor). Pflicht in production.
TRUST_PROXY=1

# --- Bootstrap-once (nur beim allerersten Start gelesen, danach gilt die DB) -
# Leer lassen = sicherer Zufallswert; das Admin-Passwort steht dann EINMALIG im Log
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Betrieb -----------------------------------------------------------------
MAX_FILE_SIZE_MB=8192
MIN_FREE_DISK_MB=1024
# Zufaelliger Wert, z. B.: openssl rand -hex 32 — dann nur noch mit Bearer-Token
METRICS_TOKEN=
LOG_FORMAT=json
LOG_LEVEL=info
# Ab welchem Level Detailmeldungen der Module (Requests, Mails, Jobs) auch auf
# der Konsole erscheinen; im Event-Log (/admin/logs) stehen sie immer
LOG_CONSOLE_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=30000
# Zeitzone fuer alle angezeigten Zeiten (Seiten, Logs, ZIP-Downloads);
# gespeichert wird immer UTC. IANA-Name, z. B. Europe/Berlin oder UTC
APP_TIMEZONE=Europe/Berlin

# --- Loeschfristen in Tagen (0 = aus) ----------------------------------------
AUDIT_LOG_RETENTION_DAYS=90
UNVERIFIED_ACCOUNT_RETENTION_DAYS=30
CLOSED_TICKET_RETENTION_DAYS=0

# --- Mailversand (SMTP) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TICKET_NOTIFY_EMAIL=
TICKET_ATTACHMENT_MAX_MB=10
# Summe der Anhänge, die einer Ticket-Mail als echte Dateien beiliegen; was
# darüber liegt, steht nur als Name mit "(im Portal)" in der Mail. 0 = nie anhängen.
MAIL_ATTACHMENT_MAX_MB=10

# --- Antworten per Mail (IMAP, optional) -------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
# Verarbeitete Mails in diesen Ordner verschieben (wird angelegt, falls er
# fehlt; manche Server verlangen "INBOX.Verarbeitet"). Leer = im Postfach
# lassen, nur als gelesen markieren.
IMAP_PROCESSED_MAILBOX=
SUPPORT_REPLY_TO=
# Neue Tickets per Mail (nicht nur Antworten): authserv-id des eigenen
# Mailservers im Header "Authentication-Results" (z. B. mx.gmx.net). Nur
# Mails verifizierter Konten mit dkim=pass/dmarc=pass unter genau dieser ID
# werden zu Tickets. Leer = nur Antworten auf bestehende Tickets.
IMAP_AUTHSERV_ID=
